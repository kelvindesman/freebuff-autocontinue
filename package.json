{
  "name": "freebuff-autocontinue",
  "version": "0.2.1",
  "description": "Zero-dependency autonomous session supervisor for Freebuff CLI with smart model fallback, Pacific Midnight refill scheduling, and graceful account switching.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "freebuff-autocontinue": "dist/cli.js"
  },
  "files": [
    "dist",
    "Formula",
    "install.sh",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --outfile=dist/cli.js && esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js && chmod +x dist/cli.js",
    "compile:bin": "bun build --compile --outfile bin/freebuff-autocontinue src/cli.ts",
    "compile:all": "bun run compile:bin",
    "test": "bun test tests/",
    "test:e2e": "bun test tests/e2e.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests scripts",
    "lint:fix": "biome check --write src tests scripts",
    "format": "biome format --write src tests scripts",
    "format:check": "biome format src tests scripts",
    "spell": "cspell --no-progress --no-summary",
    "coverage": "node scripts/coverage-gate.mjs",
    "gate:fast": "bun run lint && bun run typecheck",
    "gate": "bun run gate:fast && bun run spell && bun run coverage && bun run build && node dist/cli.js --self-test && node dist/cli.js --dry-run && npm pack --dry-run",
    "release": "node scripts/release.mjs",
    "release:tag": "node scripts/release.mjs --tag",
    "prepare": "(husky || true) && (npm run build || true)"
  },
  "keywords": [
    "freebuff",
    "codebuff",
    "ai-agent",
    "autocontinue",
    "tmux",
    "cli",
    "deepseek",
    "automation",
    "coding-agent"
  ],
  "author": "Kelvin & Contributors",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kelvindesman/freebuff-autocontinue.git"
  },
  "bugs": {
    "url": "https://github.com/kelvindesman/freebuff-autocontinue/issues"
  },
  "homepage": "https://github.com/kelvindesman/freebuff-autocontinue#readme",
  "dependencies": {},
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "^22.0.0",
    "cspell": "^10.3.6",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
