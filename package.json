{
  "name": "freebuff-autocontinue",
  "version": "0.1.2",
  "description": "Zero-dependency autonomous session supervisor for Freebuff CLI with smart model fallback, Pacific Midnight refill scheduling, and graceful account switching.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "freebuff-autocontinue": "./dist/cli.js"
  },
  "files": [
    "dist",
    "Formula",
    "install.sh",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --outfile=dist/cli.js && esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js && chmod +x dist/cli.js",
    "compile:bin": "bun build --compile --outfile bin/freebuff-autocontinue src/cli.ts",
    "compile:all": "bun run compile:bin",
    "test": "bun test tests/",
    "test:e2e": "bun test tests/e2e.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'No lint errors'",
    "prepare": "bun run build || true"
  },
  "keywords": [
    "freebuff",
    "codebuff",
    "ai-agent",
    "autocontinue",
    "tmux",
    "cli",
    "deepseek",
    "automation",
    "coding-agent"
  ],
  "author": "Kelvin & Contributors",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kelvindesman/freebuff-autocontinue.git"
  },
  "bugs": {
    "url": "https://github.com/kelvindesman/freebuff-autocontinue/issues"
  },
  "homepage": "https://github.com/kelvindesman/freebuff-autocontinue#readme",
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
