{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"src/**/*.ts",
			"tests/**/*.ts",
			"scripts/**/*.mjs",
			"*.mjs",
			"*.json"
		],
		"ignoreUnknown": true
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "space",
		"indentWidth": 2,
		"lineWidth": 90
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"correctness": {
				"noUnusedImports": "error",
				"noUnusedVariables": "error"
			},
			"suspicious": {
				"noControlCharactersInRegex": "off",
				"noExplicitAny": "error",
				"noConsole": "off"
			},
			"style": {
				"noParameterAssign": "off",
				"useNamingConvention": "off",
				"noNonNullAssertion": "warn"
			},
			"complexity": {
				"noExcessiveCognitiveComplexity": "off"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"trailingCommas": "es5",
			"semicolons": "always"
		}
	}
}